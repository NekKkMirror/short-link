    "vite-plugin-bundle-analyzer": "^0.0.1",
    "vite-plugin-ejs": "^1.7.0",
    "vite-plugin-env-compatible": "^2.0.1",
    "vite-plugin-inspect": "^0.10.6",
    "vite-plugin-vue-devtools": "^7.6.8",
    "vite-plugin-vuetify": "^2.0.4",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
